<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Reminder</AssemblyName>
    <RootNamespace>ReminderApp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <SelfContained>false</SelfContained>
    <!-- WFAC010: WinForms suggests Application.SetHighDpiMode, but WPF (the primary UI here)
         needs the manifest-based PerMonitorV2 declaration instead. -->
    <NoWarn>WFAC010</NoWarn>
    <Product>Reminder</Product>
    <Company></Company>
    <Copyright></Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
