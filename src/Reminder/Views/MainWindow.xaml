<Window x:Class="ReminderApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reminder" Width="980" Height="620" MinWidth="640" MinHeight="420"
        Icon="pack://application:,,,/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab bar -->
        <Grid Grid.Row="0" Background="{StaticResource CardBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Stretch">
                <RadioButton x:Name="ActiveTab" Style="{StaticResource TabButtonStyle}" GroupName="Tabs" IsChecked="True"
                             Click="Tab_Click" Tag="Active" Content="Active"/>
                <RadioButton x:Name="CompletedTab" Style="{StaticResource TabButtonStyle}" GroupName="Tabs"
                             Click="Tab_Click" Tag="Completed" Content="Completed"/>
            </StackPanel>

            <StackPanel x:Name="NormalActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                <Button Style="{StaticResource IconButton}" Click="ImportExport_Click" ToolTip="Import / Export" Margin="0,0,8,0">
                    <Path Data="{StaticResource IconImportExport}" Fill="{StaticResource TextSecondaryBrush}" Stretch="Uniform" Width="16" Height="16"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="Settings" Margin="0,0,8,0">
                    <Path Data="{StaticResource IconGear}" Fill="{StaticResource TextSecondaryBrush}" Stretch="Uniform" Width="17" Height="17"/>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="AddNew_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Fill="White" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="New"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel x:Name="SelectionActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,20,0" Visibility="Collapsed">
                <TextBlock x:Name="SelectionCountText" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                <Button x:Name="SelectAllButtonSelection" Content="Select all" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="SelectAllToggle_Click"/>
                <Button x:Name="BulkCompleteButton" Content="Mark complete" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="BulkComplete_Click"/>
                <Button Content="Delete" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BulkDelete_Click"/>
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="BulkCancel_Click"/>
            </StackPanel>

            <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1" Background="{StaticResource BorderBrush2}"/>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" Background="{StaticResource BgBrush}">
            <ListBox x:Name="List" Margin="16" BorderThickness="0" Background="Transparent"
                     Grid.IsSharedSizeScope="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="List_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}"
                                            BorderThickness="1" CornerRadius="8" Padding="18,5">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="TitleCol"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" ToolTip="{Binding Title}"
                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                       MaxWidth="320" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasCountdown, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Countdown}" FontSize="12" Foreground="{StaticResource AccentDarkBrush}"/>
                                    <TextBlock Text="    " FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Schedule}" FontSize="12" Foreground="{StaticResource TextSecondaryDarkBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Click="Edit_Click" Tag="{Binding}" ToolTip="Edit">
                                    <Path Data="{StaticResource IconEdit}" Fill="{StaticResource TextSecondaryBrush}" Stretch="Uniform" Width="14" Height="14"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Click="MarkComplete_Click" Tag="{Binding}" ToolTip="Mark complete">
                                    <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2" Stretch="Uniform" Width="14" Height="14"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Click="Delete_Click" Tag="{Binding}" ToolTip="Delete">
                                    <Path Data="{StaticResource IconTrash}" Fill="{StaticResource TextSecondaryBrush}" Stretch="Uniform" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText" Text="No reminders yet. Click + New to add one."
                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
