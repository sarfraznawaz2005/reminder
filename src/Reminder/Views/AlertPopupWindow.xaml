<Window x:Class="ReminderApp.Views.AlertPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="Height" Width="320" SourceInitialized="Window_SourceInitialized">
    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
            CornerRadius="10" Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.2" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconBell}" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="Reminder" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Width="22" Height="22" Click="Dismiss_Click">
                    <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="10" Height="10"/>
                </Button>
            </Grid>

            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0"/>
            <TextBlock x:Name="NotesText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="GapCol" Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SnoozeButton" Grid.Column="0" Content="Snooze" Style="{StaticResource SecondaryButton}" Click="Snooze_Click"/>
                <Button x:Name="DoneButton" Grid.Column="2" Content="Done" Style="{StaticResource PrimaryButton}" Click="Done_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
