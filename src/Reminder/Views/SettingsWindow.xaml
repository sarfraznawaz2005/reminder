<Window x:Class="ReminderApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Icon="pack://application:,,,/Assets/app.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <CheckBox x:Name="SnoozeEnabledBox" Content="Enable snooze" Margin="0,0,0,16"/>

            <TextBlock Text="Default time for new reminders" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <ComboBox x:Name="DefaultHourBox" Width="60" Margin="0,0,4,0"/>
                <ComboBox x:Name="DefaultMinuteBox" Width="60" Margin="0,0,4,0"/>
                <ComboBox x:Name="DefaultAmPmBox" Width="60">
                    <ComboBoxItem Content="AM"/>
                    <ComboBoxItem Content="PM"/>
                </ComboBox>
            </StackPanel>

            <TextBlock Text="Window behavior" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
            <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" Margin="0,0,0,8"/>
            <CheckBox x:Name="CloseToTrayBox" Content="Close to system tray" Margin="0,0,0,8"/>
            <CheckBox x:Name="MinimizeToTrayBox" Content="Minimize to system tray" Margin="0,0,0,8"/>
            <CheckBox x:Name="StartMinimizedBox" Content="Start minimized to tray" Margin="0,0,0,8"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
